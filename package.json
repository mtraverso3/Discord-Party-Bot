{
  "name": "discord-party-bot",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:admin && wrangler dev",
    "deploy": "npm run build:admin && wrangler deploy",
    "build:admin": "npm --prefix admin-ui install --no-audit --no-fund && npm --prefix admin-ui run build",
    "register": "npx tsx scripts/register.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p scripts",
    "lint": "eslint .",
    "test": "node -e \"require('fs').mkdirSync('admin-ui/dist', { recursive: true })\" && vitest run"
  },
  "dependencies": {
    "discord-hono": "^0.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.14",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.92.0"
  }
}
