{
  "name": "partybot-client",
  "version": "1.0.2",
  "description": "PartyBot desktop client — League lobby invites and party verification",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
